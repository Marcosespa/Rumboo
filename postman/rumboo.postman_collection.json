                  "pm.test('mensaje sin datos del archivo', () => pm.expect(pm.response.json().detail).to.eql('El archivo debe ser un Excel .xlsx'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar viajes",
          "request": {
