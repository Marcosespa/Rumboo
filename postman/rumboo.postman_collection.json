          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('es un .xlsx', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('spreadsheetml'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Importar archivo inválido (422)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/viajes/importar",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "esto no es un excel"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
