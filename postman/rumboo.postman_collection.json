        {
          "name": "Resultado del job",
          "request": {
            "method": "GET",
            "url": "{{satrackUrl}}/v1/jobs/{{satJobId}}",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const n = Number(pm.collectionVariables.get('intentos') || 0);",
                  "if (!(body.status === 'done') && n < 60) {",
                  "  pm.collectionVariables.set('intentos', n + 1);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "  setTimeout(() => {}, 1000);",
                  "} else {",
                  "  pm.collectionVariables.set('intentos', 0);",
                  "  pm.test('job terminado', () => pm.expect(body.status).to.eql('done'));",
                  "  pm.test('posición de la placa', () => pm.expect(body.result.positions[0].plate).to.eql(pm.collectionVariables.get('placa')));",
                  "}"
                ]
              }
            }
          ]
        }
