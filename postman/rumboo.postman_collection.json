      "item": [
        {
          "name": "Salud del scraper",
          "request": {
            "method": "GET",
            "url": "{{satrackUrl}}/health",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
