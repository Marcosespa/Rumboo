            "url": "{{baseUrl}}/api/viajes/{{tripId}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('trae remesas y eventos', () => { const t = pm.response.json(); pm.expect(t.remesas).to.have.length(2); pm.expect(t.eventos).to.not.be.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Vehículos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/vehiculos",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
