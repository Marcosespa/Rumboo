{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/feedback/**",
              "components/forms/**",
              "components/icons/**",
              "components/layout/**",
              "components/navigation/**",
              "ui_kits/rumbo-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Inter Tight))/i]",
        "message": "Font not provided by the design system. Available: Inter, Inter Tight."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:severity|title|detail|meta|pill|actions|className|key|ref|className|style|children)$/]",
        "message": "<AlertCard> doesn't accept that prop. Declared props: severity, title, detail, meta, pill, actions, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertCard'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:attention|critical)$/]",
        "message": "<AlertCard> severity must be one of 'attention' | 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|logoSrc|rightMeta|onRefresh|onLogout|className|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: title, subtitle, logoSrc, rightMeta, onRefresh, onLogout, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onSelect|badges|fixed|className|key|ref|className|style|children)$/]",
        "message": "<BottomNav> doesn't accept that prop. Declared props: items, active, onSelect, badges, fixed, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|loading|as|disabled|onClick|className|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, loading, as, disabled, onClick, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|secondary|light|lightGhost|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'secondary' | 'light' | 'lightGhost' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg)$/]",
        "message": "<Button> size must be one of 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|text|className|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, text, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|placeholder|type|value|onChange|className|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, placeholder, type, value, onChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onClick|children|className|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: active, onClick, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:overline|figure|caption|tone|metrics|actions|children|className|key|ref|className|style|children)$/]",
        "message": "<HeroPanel> doesn't accept that prop. Declared props: overline, figure, caption, tone, metrics, actions, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroPanel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|primary)$/]",
        "message": "<HeroPanel> tone must be one of 'ink' | 'primary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|onClick|className|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|amount|tone|className|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: title, meta, amount, tone, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:expense|income|neutral)$/]",
        "message": "<ListRow> tone must be one of 'expense' | 'income' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|action|children|className|key|ref|className|style|children)$/]",
        "message": "<SectionCard> doesn't accept that prop. Declared props: title, subtitle, action, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|block|className|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, block, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|onChange|className|key|ref|className|style|children)$/]",
        "message": "<SelectField> doesn't accept that prop. Declared props: label, options, value, onChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|value|className|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: icon, title, value, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|solid|withIcon|children|className|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: status, solid, withIcon, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:ok|attention|critical|success|warning|accent)$/]",
        "message": "<StatusPill> status must be one of 'ok' | 'attention' | 'critical' | 'success' | 'warning' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextAreaField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|rows|placeholder|value|onChange|className|key|ref|className|style|children)$/]",
        "message": "<TextAreaField> doesn't accept that prop. Declared props: label, rows, placeholder, value, onChange, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
