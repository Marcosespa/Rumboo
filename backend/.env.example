DATABASE_URL=postgresql+psycopg://rumboo:rumboo@localhost:5432/rumboo
SECRET_KEY=replace-with-a-generated-32-character-secret
# Claves Fernet separadas por coma, la vigente primero (scripts/setup_env.py la genera)
ENCRYPTION_KEYS=
SATRACK_SERVICE_API_KEY=replace-with-generated-secret
CALLBACK_SECRET=replace-with-generated-secret
SATRACK_SERVICE_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:5173
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_S=60
RECONCILIATION_INTERVAL_S=5
EVENTOS_INTERVAL_S=2
RUNNER_LOCK_CHECK_S=1
CONSULTA_TIMEOUT_S=240
SESSION_DAYS=7
